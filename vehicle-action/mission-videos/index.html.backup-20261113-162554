<title>Watch Mission — Alex's Amazing Garage</title>
<style>
:root{
  --ink:#173254;
  --ink-deep:#0f2438;
  --paper:#f4e6cf;
  --paper-2:#f8ecd9;
  --gold:#ffcc35;
  --gold-deep:#d69a00;
  --blue:#2f95ff;
  --blue-deep:#1767c6;
  --red:#f44747;
  --red-deep:#b92c2c;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{
  font-family:"Trebuchet MS","Segoe UI",Arial,sans-serif;
  color:#13213a;
  background:linear-gradient(180deg,#f7ecd9 0%,#efdfc3 100%);
}
a{text-decoration:none}
.mission-shell{min-height:100svh;display:flex;flex-direction:column;padding:10px 14px 18px}
.mission-topbar{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:10px;
  padding:8px 10px;
  background:linear-gradient(180deg,#faebc6 0%,#efd48a 100%);
  border:2px solid #f1bf2a;
  border-radius:20px;
  box-shadow:0 8px 20px rgba(69,49,9,.12);
}
.nav-left,.nav-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.nav-right{justify-content:flex-end}
.top-btn{
  min-height:44px;
  padding:0 16px;
  border-radius:14px;
  border:2px solid var(--blue-deep);
  background:linear-gradient(180deg,#37a7ff 0%,#2485e8 100%);
  color:#fff;
  font:800 18px/1 "Trebuchet MS","Segoe UI",sans-serif;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  box-shadow:0 3px 0 var(--blue-deep);
}
.top-btn.icon{min-width:44px;padding:0 10px}
.top-btn.find{background:linear-gradient(180deg,#ff6767 0%,#ef3131 100%);border-color:var(--red-deep);box-shadow:0 3px 0 var(--red-deep)}
.top-btn.watch{background:linear-gradient(180deg,#ffd454 0%,#ffbd1f 100%);border-color:var(--gold-deep);box-shadow:0 3px 0 var(--gold-deep);color:#5b3800}
.top-btn.back{min-width:170px}
.title-pill{
  min-width:min(340px,90vw);
  padding:10px 22px;
  border-radius:18px;
  border:2px solid var(--blue-deep);
  background:linear-gradient(180deg,#38abff 0%,#2485e8 100%);
  color:#fff;
  font:900 clamp(28px,3.2vw,44px)/1 "Trebuchet MS","Segoe UI",sans-serif;
  text-align:center;
  box-shadow:0 4px 0 var(--blue-deep);
}
.player-wrap{flex:1;display:flex;justify-content:center;padding-top:14px}
.player-card{
  width:min(1180px,100%);
  background:linear-gradient(180deg,#f7ead5 0%,#f1e0c1 100%);
  border:3px solid #f0c64c;
  border-radius:28px;
  box-shadow:0 16px 32px rgba(31,33,39,.14);
  padding:22px clamp(14px,2.8vw,34px) 24px;
}
.eyebrow{margin:0 0 4px;color:#7c5d1c;font:800 15px/1.2 "Trebuchet MS","Segoe UI",sans-serif;letter-spacing:.02em}
#title{margin:0;color:#173254;font-size:clamp(31px,4vw,52px);line-height:1.06}
#description{margin:10px 0 18px;color:#314b6d;font-size:clamp(18px,2.2vw,28px);font-weight:700}
.video-frame{
  width:100%;
  border-radius:24px;
  border:4px solid #237cd8;
  overflow:hidden;
  background:#0f1f31;
  box-shadow:0 14px 28px rgba(16,36,56,.22);
  aspect-ratio:16/9;
}
video{display:block;width:100%;height:100%;object-fit:contain;background:#07111d}
.error{min-height:1.5em;margin:12px 0 0;color:#b62626;font-weight:800;font-size:18px}
.actions{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:18px}
.switch{
  min-height:56px;
  min-width:220px;
  padding:0 22px;
  border:2px solid var(--gold-deep);
  border-radius:18px;
  background:linear-gradient(180deg,#ffd455 0%,#ffbd20 100%);
  color:#563300;
  font:900 20px/1 "Trebuchet MS","Segoe UI",sans-serif;
  box-shadow:0 4px 0 var(--gold-deep);
  cursor:pointer;
}
.switch:hover,.top-btn:hover,.title-pill:hover{filter:brightness(1.03)}
.switch:disabled{opacity:.45;cursor:not-allowed}
.help{margin:16px 0 0;color:#4c6281;font:700 18px/1.35 "Trebuchet MS","Segoe UI",sans-serif}
@media (max-width:1050px){
  .mission-topbar{grid-template-columns:1fr;justify-items:center}
  .nav-left,.nav-right{justify-content:center}
  .nav-right{width:100%}
  .title-pill{min-width:min(320px,100%)}
}
@media (max-width:700px){
  .mission-shell{padding:8px}
  .player-card{padding:16px 12px 18px}
  .top-btn{font-size:16px;min-height:42px;padding:0 12px}
  .switch{flex:1 1 100%;min-width:0;font-size:18px;min-height:52px}
  .actions{justify-content:stretch}
}
</style>
